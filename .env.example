APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4
# CLI php.exe for Security Monitoring “Monitor now” (composer audit). Required when
# the web SAPI is php-cgi/Apache — use php.exe, not php-cgi.exe. Paths with spaces OK.
# PHP_CLI_BINARY="C:\laragon\bin\php\php-8.3.0\php.exe"

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Idle cookie session lifetime in minutes (10080 = 7 days). Platform default when a
# hub has no hubs.session_lifetime_minutes override (set via Active sessions UI).
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Production same-site SPA+API: SESSION_SAME_SITE=lax (or strict), SESSION_SECURE_COOKIE=true
# Cross-site SPA (different host than API): SESSION_SAME_SITE=none, SESSION_SECURE_COOKIE=true
# NFR-SEC-NAV: prefer strict when SPA+API share a site so email/cross-site top-level
# navigations do not send the session cookie; keep lax/none if your deploy needs it.
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=
SESSION_HTTP_ONLY=true

# NFR-SEC-NAV — external link / copied-URL blocking (SPA enforces error page)
SECURITY_NAV_ENABLED=true
SECURITY_NAV_RECORD_EVENTS=true

# NFR-SEC-FW — application-layer firewall + upload malware protection
# (Not a network WAF; keep host/cPanel firewall in ops. See PROJECT_REQUIREMENTS §9.5.)
SECURITY_FIREWALL_ENABLED=true
# Comma-separated IPs, CIDRs, or hyphen ranges (e.g. 203.0.113.10-203.0.113.50)
SECURITY_FIREWALL_DENIED_IPS=
# Optional: temporarily block IP after failed-login threshold (Security Monitoring)
SECURITY_FIREWALL_AUTO_BLOCK=false
SECURITY_FIREWALL_AUTO_BLOCK_MINUTES=60
SECURITY_FIREWALL_RECORD_EVENTS=true
# GeoIP for hub access restrictions (UK / countries / cities). Prefer CDN headers;
# HTTP fallback is optional (disable on hosts that cannot call out).
ACCESS_RESTRICTION_BYPASS_PRIVATE_IPS=true
# When true, users with Access control capability are never hard-403'd by geo/IP/VPN rules
# (logged as would_block) so admins can recover from self-lockout.
ACCESS_RESTRICTION_ADMIN_ESCAPE=true
# Comma-separated reverse-proxy IPs/CIDRs allowed to set X-Forwarded-*. Empty = ignore
# forwarding headers (safe when clients can hit Laravel directly). Use * only if the
# origin is firewalled so traffic must come through Cloudflare/LB.
TRUSTED_PROXIES=
GEOIP_HTTP_ENABLED=true
# GEOIP_HTTP_URL=http://ip-api.com/json/{ip}?fields=status,countryCode,city,proxy,hosting
GEOIP_CACHE_MINUTES=1440
GEOIP_TIMEOUT=2
# Count datacenter/hosting exits as VPN for Restrict VPN / Allow VPN rules.
GEOIP_TREAT_HOSTING_AS_VPN=true
# Accept CF-IPCountry / X-App-Geo-* from the edge.
GEOIP_TRUST_HEADERS=true
# When true (default outside local/testing), ignore geo headers unless the request
# is from TRUSTED_PROXIES — stops clients forging CF-IPCountry on a direct origin hit.
# GEOIP_REQUIRE_TRUSTED_PROXY_FOR_HEADERS=true
# Weak generic headers (X-Country-Code / X-City). Keep false unless your edge sets them.
GEOIP_TRUST_GENERIC_HEADERS=false
SECURITY_UPLOAD_SCAN_ENABLED=true
SECURITY_UPLOAD_BLOCK_SVG=true
# Optional ClamAV: install clamscan on the server, then set MALWARE_SCAN_ENABLED=true
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_BINARY=clamscan
# When true, refuse uploads if clamscan is missing or errors (default false for cPanel)
MALWARE_SCAN_REQUIRED=false
MALWARE_SCAN_TIMEOUT=30

# NFR-SEC-APP — SQLi/XSS/CSRF/brute-force + app-layer abuse throttling
# (Volumetric DDoS / CDN WAF remain ops — see PROJECT_REQUIREMENTS §9.6.)
SECURITY_API_RATE_PER_MINUTE=120
SECURITY_AUTH_RATE_PER_MINUTE=20
SECURITY_SANITIZE_RICH_HTML=true

# NFR-SEC-VAL — server-side validation + sanitization of all user inputs (§9.8)
# Scrub null bytes / control chars on every API string before validation.
SECURITY_SANITIZE_REQUEST_INPUT=true

# Sanctum personal access token lifetime in minutes (10080 = 7 days). Empty = never expire.
SANCTUM_EXPIRATION=10080
# Comma-separated hosts allowed for cookie SPA auth (defaults include FRONTEND_URL host + localhost).
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,sharedhub.fin-proms.com

# Extra CORS origins (comma-separated). FRONTEND_URL is always allowed.
# CORS_ALLOWED_ORIGINS=https://sharedhub.example.com,https://client.example.com

# Outbound HTTPS cert verification for cPanel sync / embed proxy (keep true in production).
HTTP_TLS_VERIFY=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# -----------------------------------------------------------------------------
# PRODUCTION CONCURRENCY (multi-user)
# -----------------------------------------------------------------------------
# 1) Install Redis on the server (or Redis Cloud / ElastiCache).
# 2) Do NOT enable Redis yet unless Redis is installed AND tested.
#    Keep CACHE_STORE=file (or database) and QUEUE_CONNECTION=database until then.
#    A broken Redis setting can 500 /api/hub and other APIs.
# 3) Run continuously (Supervisor / cPanel cron / systemd):
#      php artisan queue:work --sleep=1 --tries=3 --timeout=300
#      php artisan schedule:work
#    (or cron: * * * * * php /path/to/artisan schedule:run)
# 4) After deploy: php artisan config:cache && php artisan route:cache
# 5) NEVER use QUEUE_CONNECTION=sync in production.
# Local/dev may keep database drivers if Redis is unavailable.
# -----------------------------------------------------------------------------
QUEUE_CONNECTION=database
# QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# REDIS_QUEUE=default

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

FRONTEND_URL=http://localhost:5173

# Current hub for this deploy:
#   central — Central Hub Controller (control plane ONLY)
#   shared / shared-* / custom + HUB_TYPE=shared — Shared content hub (many allowed)
#   <slug>  — White-labelled hub
HUB_SLUG=shared
HUB_TYPE=shared

# Code release version for this deploy (defaults to root VERSION file).
# After a Git/FTP deploy, set these to the release you just shipped so Central
# can track which hubs are up to date via GET /api/version.
# APP_VERSION=1.0.0
# FRONTEND_VERSION=1.0.0
# Where Phase 2 extracts frontend dist zip on this server (optional).
# CODE_UPDATE_FRONTEND_PATH=/home/user/public_html
# Shared secret for apply/artifact auth (separate from HUB_BACKUP_SECRET).
# HUB_CODE_UPDATE_SECRET=
# Extra hosts allowed for artifact downloads (comma-separated), plus CENTRAL_API_URL / APP_URL.
# HUB_CODE_UPDATE_ALLOWED_DOWNLOAD_HOSTS=central.fin-proms.com

# true ONLY on Central Hub Controller (HUB_SLUG=central). Shared/White-label = false.
HUB_IS_CONTROL_PLANE=false

# One-time: promote this deploy's hub row to type=central (Central first install)
# HUB_PROMOTE_TO_CENTRAL=true

# Public URL for Storage::disk('public') assets (logos, favicons, uploads).
# Same-domain Option B (Laravel in /api): use the media route (most reliable on cPanel):
# FILESYSTEM_PUBLIC_URL=https://sharedhub.fin-proms.com/api/media
# Leave empty to default to APP_URL/storage
FILESYSTEM_PUBLIC_URL=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_ENABLED=true

# Bank transfer test path (auto-grants credits). Keep false in production.
BANK_TRANSFER_ENABLED=false
BANK_TRANSFER_AUTO_CONFIRM=false

# Website Compliance (deployed advisor sites / cPanel sync / preview capture)
# Hub API base the live template calls back to (defaults to APP_URL/api when empty)
WEBSITE_COMPLIANCE_HUB_API_URL=
# Origin used to resolve uploaded image URLs on live sites (defaults to hub API URL)
WEBSITE_COMPLIANCE_UPLOADS_ORIGIN=
# Optional: HTTP catch-up for missed delayed jobs.
# Prefer header: X-Scheduler-Key: <SCHEDULER_SECRET>
# Query-string ?key= is rejected (log / Referer leak).
# Scheduling uses BOTH:
#   1) Delayed queue job when an approver sets scheduled_at (requires queue worker)
#   2) Every-minute artisan schedule: wc:publish-scheduled (requires schedule:work / cron)
# Keep QUEUE_CONNECTION=database (or redis) — NEVER sync.
# Queued work includes: scheduled WC publishes, cPanel live sync, template preview
# capture, advisor Excel import, Central library Excel import, and content
# distribute / post sync.
# Run: `php artisan queue:work` AND `php artisan schedule:work` (or system cron for schedule:run)
SCHEDULER_SECRET=
# UK GDPR retention prune (php artisan gdpr:prune-retention — scheduled daily 02:30).
# Set any value to 0 to disable that category. Does not prune compliance audits or hub backups.
GDPR_RETENTION_ACTIVITY_LOGS_DAYS=365
GDPR_RETENTION_LOGIN_OTP_HOURS=24
GDPR_RETENTION_EMAIL_VERIFICATION_DAYS=7
GDPR_RETENTION_PASSWORD_RESET_DAYS=2
GDPR_RETENTION_SESSIONS_DAYS=30
GDPR_RETENTION_ADVISOR_IMPORT_FILES_DAYS=90
GDPR_RETENTION_CLOSED_SUPPORT_TICKETS_DAYS=365
# Hub backups / internal machine auth (per-hub tokens preferred / auto-generated).
# Purpose-scoped shared fallbacks — do NOT reuse the same value across purposes:
#   HUB_BACKUP_SECRET      → X-Hub-Backup-Key     (run / receive only)
#   HUB_RESTORE_SECRET     → X-Hub-Restore-Key    (DB restore only)
#   HUB_GC_FILE_SECRET     → X-Hub-Gc-File-Key    (GC encrypted file bridge)
#   HUB_DEPLOY_ENV_SECRET  → X-Hub-Deploy-Env-Key (.env allowlist write)
# Optional: comma-separated IPs/CIDRs allowed to call /api/internal/* (empty = any).
# HUB_INTERNAL_ALLOWED_IPS=203.0.113.10,10.0.0.0/8
# HUB_INTERNAL_RATE_PER_MINUTE=30
# HUB_RESTORE_RATE_PER_MINUTE=5
# On content hubs: prefer setting CENTRAL_API_URL via Power Admin → Hubs →
# Deploy wiring → Save / “Push deploy env” (writes these keys into the hub .env).
# Manual fallback still works:
#   CENTRAL_API_URL=https://central.fin-proms.com/api
#   CENTRAL_ALLOWED_RECEIVE_HOSTS=central.fin-proms.com
HUB_BACKUP_SECRET=
HUB_RESTORE_SECRET=
HUB_GC_FILE_SECRET=
HUB_DEPLOY_ENV_SECRET=
# HUB_INTERNAL_ALLOWED_IPS=
CENTRAL_API_URL=
# CENTRAL_ALLOWED_RECEIVE_HOSTS=
HUB_BACKUP_UPLOAD_TIMEOUT=600
# NFR-BACKUP-ENC: encrypt backup ZIP archives at rest (AES-256-GCM).
# Use the SAME base64 key on Central and every content hub (generate once):
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)), PHP_EOL;"
HUB_BACKUP_ENCRYPT_AT_REST=true
HUB_BACKUP_ENCRYPTION_KEY=
# Base URL used when auto-building template preview URLs (empty = APP_URL)
# myhub example: TEMPLATE_PREVIEW_BASE_URL=https://myhub.fin-proms.com
TEMPLATE_PREVIEW_BASE_URL=
# Optional CSV override of which showcase templates this deploy owns
# (defaults come from config services.website_compliance.hub_showcase_templates)
# WC_SHOWCASE_TEMPLATES=template4
# Optional absolute path to node binary for Puppeteer preview capture
TEMPLATE_PREVIEW_NODE_BINARY=
